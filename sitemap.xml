---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for entry in site.pages %}{% if entry.sitemap == false %}{% continue %}{% endif %}{% if entry.layout == "page" or entry.layout == "research-guide" %}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>{% if entry.reviewed %}
    <lastmod>{{ entry.reviewed | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endif %}{% endfor %}
  <url>
    <loc>{{ '/spark.pdf' | absolute_url | xml_escape }}</loc>
  </url>
</urlset>
